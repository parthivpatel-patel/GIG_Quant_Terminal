# Copy to .env and fill in. Never commit .env.

GIG_LOG_LEVEL=INFO
GIG_DATA_DIR=data
GIG_RESULTS_DIR=results
GIG_DATA_SOURCE=yahoo
GIG_DB_PATH=data/gig.duckdb
GIG_UNIVERSE_FILE=configs/universe.yaml

# FRED (free) — https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=

# Finnhub (free personal) — https://finnhub.io/register
# FINNHUB_API_KEY=

# SEC EDGAR (free) — must include a real email
# EDGAR_USER_AGENT=GIG research your.email@example.com

# Alpaca paper + IEX quotes (free) — https://alpaca.markets
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets
# ALPACA_DATA_URL=https://data.alpaca.markets
